<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimum set for this probe: energy (EV SOC / fuel), drive (odometer), info (battery capacity). -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- TextToSpeech SDK (normal permission). -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Vehicle control probe (writes the SAME value it just read, so state does not change). -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_ENERGY" />

    <!-- FusedLocation SDK. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- NaviHelper: get*Info() / requestTrip() = NAVI_ROUTE, requestRoute() etc. = NAVI_ROUTE_SEARCH. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:allowBackup="false"
        android:label="ZZAN SDK Probe"
        android:theme="@android:style/Theme.DeviceDefault">
        <activity
            android:name=".ProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo Action for component "activity" (see assets/schema.json). -->
            <intent-filter>
                <action android:name="GET_SAVINGS_SUMMARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Media probe: images / animation / video / 3D at a chosen moment. -->
        <activity
            android:name=".MediaActivity"
            android:exported="true" />

        <!-- Gleo Actions for component "service" arrive as broadcasts. -->
        <receiver
            android:name=".GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="FIND_CHEAPEST_STATION" />
                <action android:name="COMPARE_ROUTE_COST" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
